+      const client = getClient();
+      const { data, error } = await client.rpc('get_public_share', { p_share_id: shareId });
+      if (error) fail(MSG.shareLoad, error);
+      if (!data) fail(MSG.shareNotFound, null);
+      return data as SharedCategoryRecord;
+    },
+  };
