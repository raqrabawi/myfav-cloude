{
  "name": "myfav-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "MyFav V2 \u2014 Supabase-first personal web curator (UI identical to MyFav original).",
  "scripts": {
    "dev": "vite --port 3000 --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && node scripts/check-forbidden.mjs",
    "test": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "test:e2e": "playwright test tests/e2e",
    "test:visual": "playwright test tests/visual",
    "db:local:apply": "bash scripts/local-db.sh apply",
    "auth:smoke": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/neon-auth-smoke.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.14.2",
    "@neon/env": "^2.1.5",
    "@neon/neon-js": "^0.10.2",
    "lucide-react": "0.546.0",
    "motion": "12.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/jsdom": "^27.0.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "27.0.0",
    "pg": "8.23.1",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "4.0.8"
  }
}
