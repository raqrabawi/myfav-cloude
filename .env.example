# ---------------------------------------------------------------------------
# MyFav V2 — browser environment (Vite). Copy to .env.local and fill in.
# ONLY public values belong here: they are embedded in the client bundle.
# ---------------------------------------------------------------------------

# Neon HTTPS database URL (NOT the postgres:// connection string — that one
# contains a password and startup validation refuses it).
# Find it in the Neon Console: Data API URL minus ".apirest" and "/rest/v1", e.g.
#   Data API: https://ep-xxx.apirest.c-9.us-east-2.aws.neon.tech/neondb/rest/v1
#   =>        https://ep-xxx.c-9.us-east-2.aws.neon.tech/neondb
# MyFav project, branch production (v2-dev: https://ep-floral-violet-bewnf699.c-9.us-east-2.aws.neon.tech/neondb)
VITE_NEON_URL="https://ep-icy-firefly-be63sv9l.c-9.us-east-2.aws.neon.tech/neondb"

# Neon Auth server values (used by `npm run auth:smoke`; public, not secrets)
NEON_AUTH_BASE_URL="https://ep-icy-firefly-be63sv9l.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth"

# Optional analytics (unchanged from the original app)
# Google Analytics 4 Measurement ID (defaults to the original G-EM5F71Y8GW in code)
VITE_GA_MEASUREMENT_ID=""
# Google Tag Manager Container ID (e.g. GTM-XXXXXXX)
VITE_GTM_ID=""
