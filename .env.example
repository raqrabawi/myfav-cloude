# ---------------------------------------------------------------------------
# MyFav V2 — browser environment (Vite). Copy to .env.local and fill in.
# ONLY public values belong here: they are embedded in the client bundle.
# ---------------------------------------------------------------------------

# Supabase project URL (Project Settings -> API). Must be https:// in production.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"

# Supabase publishable key (sb_publishable_...) or legacy anon JWT.
# NEVER use the secret / service_role key in a VITE_* variable — startup
# validation refuses it.
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
# VITE_SUPABASE_ANON_KEY="eyJ..."   # legacy alternative to the line above

# Optional analytics (unchanged from the original app)
# Google Analytics 4 Measurement ID (defaults to the original G-EM5F71Y8GW in code)
VITE_GA_MEASUREMENT_ID=""
# Google Tag Manager Container ID (e.g. GTM-XXXXXXX)
VITE_GTM_ID=""
